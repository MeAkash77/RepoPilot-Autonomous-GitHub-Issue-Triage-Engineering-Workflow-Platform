FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/worker/pyproject.toml apps/worker/pyproject.toml
COPY packages/core/pyproject.toml packages/core/pyproject.toml
COPY packages/agent/pyproject.toml packages/agent/pyproject.toml
COPY packages/retrieval/pyproject.toml packages/retrieval/pyproject.toml
COPY packages/github/pyproject.toml packages/github/pyproject.toml
COPY packages/llm/pyproject.toml packages/llm/pyproject.toml
COPY evals/pyproject.toml evals/pyproject.toml
COPY mcp-server/pyproject.toml mcp-server/pyproject.toml
RUN uv sync --frozen --no-install-workspace --no-dev

COPY apps apps
COPY packages packages
COPY evals evals
COPY mcp-server mcp-server
RUN uv sync --frozen --no-dev --package repopilot-worker

FROM python:3.12-slim-bookworm

WORKDIR /app
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$PATH"

CMD ["arq", "repopilot_worker.main.WorkerSettings"]
