# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Data stores (docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://repopilot:repopilot@localhost:5432/repopilot
REDIS_URL=redis://localhost:6379/0

# GitHub App (created in Phase 1 — see docs/github-app-setup.md)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# LLM providers (free tiers)
GROQ_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Langfuse Cloud (free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Cost controls
MAX_COST_PER_RUN_USD=0.02

# Internal API key — shared between FastAPI and Next.js BFF proxy
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=
