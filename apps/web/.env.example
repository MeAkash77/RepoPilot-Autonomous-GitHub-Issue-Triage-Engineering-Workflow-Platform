# Copy to .env.local — never commit .env.local

# GitHub OAuth — from the GitHub App settings page → OAuth credentials
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth.js secret — generate: openssl rand -hex 32
AUTH_SECRET=

# Shared internal key — must match INTERNAL_API_KEY in root .env
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# FastAPI base URL (docker-compose: http://api:8000, local: http://localhost:8000)
API_URL=http://localhost:8000
